msgid "plugins.importexport.csv.versionMustBePositiveInteger"
msgstr "Version must be a positive integer greater than 0."

msgid "plugins.importexport.csv.duplicatePreprintVersionFound"
msgstr "A preprint with identifier \"{$identifier}\" and version \"{$version}\" already exists in this import. Please check the article's version."

msgid "plugins.importexport.csv.duplicatePreprintVersionLocaleFound"
msgstr "A preprint with identifier \"{$identifier}\", version \"{$version}\", and locale \"{$locale}\" already exists in this import. Please check the article's version and locale combination."

msgid "plugins.importexport.csv.invalidReferencesFile"
msgstr "Invalid references file: \"{$filename}\". Please verify the file exists and is readable."

msgid "plugins.importexport.csv.invalidReferencesFileExtension"
msgstr "References file must have a .txt extension."

msgid "plugins.importexport.csv.invalidOrcidFormat"
msgstr "Invalid ORCID format: \"{$orcid}\". Accepted formats: URL (https://orcid.org/0000-0000-0000-0000), dashed (0000-0000-0000-0000), or numeric (0000000000000000)."

msgid "plugins.importexport.csv.invalidOrcidChecksum"
msgstr "Invalid ORCID checksum for: \"{$orcid}\". Please verify the ORCID is correct."

msgid "plugins.importexport.csv.invalidVorDoiFormat"
msgstr "Invalid VOR DOI format: \"{$vorDoi}\". Accepted formats: DOI URL (https://doi.org/10.1234/example), DOI identifier (10.1234/example), or with prefix (doi:10.1234/example)."

msgid "plugins.importexport.csv.usernameNotFoundUsingDefault"
msgstr "Notice: Username \"{$username}\" not found. Submission ID {$submissionId} was added using default user \"{$defaultUsername}\"."

msgid "plugins.importexport.csv.fundingPluginNotEnabled"
msgstr "The Funding plugin is not installed or not enabled for this server. Please enable it before importing rows with funders data."

msgid "plugins.importexport.csv.invalidFunderFormat"
msgstr "Invalid funder format at position {$index}. Each funder must have at least a name."

msgid "plugins.importexport.csv.funderNotInCrossrefRegistry"
msgstr "Funder \"{$funderName}\" at position {$index} is not from the Crossref Funder Registry. The funder identification must be a valid Crossref DOI (e.g., http://dx.doi.org/10.13039/...)."

msgid "plugins.importexport.csv.funderMissingCrossrefId"
msgstr "Funder \"{$funderName}\" at position {$index} is missing a Crossref Funder Registry identification. Please provide a valid Crossref DOI (e.g., http://dx.doi.org/10.13039/...)."

msgid "plugins.importexport.csv.skippingInvalidFile"
msgstr "Skipping \"{$filename}\" (file from previous failed import). To re-import failed rows, fix errors in this file, rename it without the 'invalid_' prefix, and run the import again."

msgid "plugins.importexport.csv.ExecutedInNSeconds"
msgstr "Executed in: {$seconds} seconds.\n"
