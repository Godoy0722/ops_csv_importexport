msgid "plugins.importexport.csv.form.importFile.description"
msgstr "Upload a ZIP file containing CSV files and assets (cover images, galley files), or a single CSV file directly."

msgid "plugins.importexport.csv.form.zipHelp"
msgstr "Upload a ZIP file built in one of two simple ways:<br><br><b>Option 1 — Everything together:</b> Put your CSV file and all its assets (PDFs, images, and other files) side by side at the top level of the ZIP.<br><b>Option 2 — Everything in one folder:</b> Put your CSV file and all its assets inside a single folder, then ZIP that folder. The plugin finds the folder automatically.<br><br>In both cases, the file path you write in each CSV column must match where the file actually sits in the ZIP. If a file is inside a subfolder, use its relative path (e.g., <em>galleys/article.pdf</em>). Files named <em>invalid_*.csv</em> are reserved for error output and are skipped during import."

msgid "plugins.importexport.csv.form.examplesHelp"
msgstr "<b>Need an example?</b> You can view and download ready-to-use sample preprint CSV files here: <a href=\"https://github.com/Godoy0722/ops_csv_importexport/tree/stable-3_5_0/examples/preprints\" target=\"_blank\" rel=\"noopener noreferrer\">CSV examples for preprints</a>."

msgid "plugins.importexport.csv.form.userImportHelp"
msgstr "For user imports, you can upload a single CSV file directly without zipping. If you have multiple CSV files, bundle them into a ZIP archive following the same structure rules described for preprints above."

msgid "plugins.importexport.csv.form.usersExamplesHelp"
msgstr "<b>Need an example?</b> You can view and download ready-to-use sample user CSV files here: <a href=\"https://github.com/Godoy0722/ops_csv_importexport/tree/stable-3_5_0/examples/users\" target=\"_blank\" rel=\"noopener noreferrer\">CSV examples for users</a>."

