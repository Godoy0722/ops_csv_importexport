msgid "plugins.importexport.csv.abstractRequiredBySection"
msgstr "Abstract is required for this section but not provided."

msgid "plugins.importexport.csv.userAlreadyExistsWithEmail"
msgstr "User already exists with email \"{$email}\"."

msgid "plugins.importexport.csv.userAlreadyExistsWithUsername"
msgstr "User already exists with username \"{$username}\"."

msgid "plugins.importexport.csv.roleDoesntExist"
msgstr "Role \"{$role}\" doesn't exist."

msgid "plugins.importexport.csv.invalidStartDate"
msgstr "The subscription start date \"{$date}\" is not valid. Format required: YYYY-MM-DD."

msgid "plugins.importexport.csv.invalidEndDate"
msgstr "The subscription end date \"{$date}\" is not valid. Format required: YYYY-MM-DD."

msgid "plugins.importexport.csv.endDateBeforeStartDate"
msgstr "The subscription end date must be later than the start date."

msgid "plugins.importexport.csv.missingSubscriptionFields"
msgstr "Missing required subscription fields (start_date and end_date) for user \"{$email}\"."

msgid "plugins.importexport.csv.subscriptionTypeDoesntExist"
