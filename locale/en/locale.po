msgid "plugins.importexport.csv.noAuthorGroup"
msgstr "There is no default author group in the journal {$journal}."

msgid "plugins.importexpot.csv.fileProcessFinished"
msgstr "Process for file \"{$filename}\" finished. {$processedRows} rows processed. {$failedRows} rows with error."

msgid "plugins.importexport.csv.invalidBookCoverImage"
msgstr "The cover image has an invalid format for this row."

msgid "plugins.importexport.csv.erroWhileSavingBookCoverImage"
msgstr "An error occurred while saving the book cover image."

msgid "plugins.importexport.csv.noGenre"
msgstr "There is no {$genreName} genre."

msgid "plugins.importexport.csv.errorWhileSavingSubmissionFile"
msgstr "An error occurred while saving the Submission file."

msgid "plugins.importexport.csv.errorWhileSavingSupplementaryFile"
